# Application
APP_NAME=Payment Pulse
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# PostgreSQL (use DATABASE_URL to override the values below)
POSTGRES_DB=payment_pulse
POSTGRES_USER=payment_pulse
POSTGRES_PASSWORD=change-me-before-deployment
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://payment_pulse:change-me-before-deployment@db:5432/payment_pulse

# Payment Data Engine
TRANSACTION_COUNT=500000
RANDOM_SEED=42
START_TIMESTAMP=2026-01-01T00:00:00+00:00
TRANSACTION_FREQUENCY_SECONDS=1
